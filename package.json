{
  "name": "universal-api-layer",
  "version": "0.6.0",
  "type": "module",
  "description": "HTTP, streaming SSE and WebSocket clients with optional React/Vue adapters, managed sessions, response schemas and isolated query caches.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "bin": {
    "universal-api-layer": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.js"
    },
    "./websocket/react": {
      "types": "./dist/websocket/react.d.ts",
      "import": "./dist/websocket/react.js"
    },
    "./websocket/vue": {
      "types": "./dist/websocket/vue.d.ts",
      "import": "./dist/websocket/vue.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:consumers": "node scripts/consumers.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "lint": "eslint src tests scripts tsup.config.ts",
    "format": "prettier --write src tests scripts examples *.json *.md *.ts *.mjs .github",
    "format:check": "prettier --check src tests scripts examples *.json *.md *.ts *.mjs .github",
    "check": "node scripts/check.mjs",
    "audit:all": "npm audit --audit-level=low",
    "prepublishOnly": "node scripts/check.mjs",
    "audit:report": "node scripts/audit-report.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/vue-query": "^5.0.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/vue-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/vue-query": "^5.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.21.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "api-client",
    "http-client",
    "fetch",
    "react",
    "vue",
    "javascript",
    "typescript",
    "tanstack-query",
    "react-query",
    "vue-query",
    "hooks",
    "composables",
    "authentication",
    "validation",
    "cache-invalidation",
    "token-refresh",
    "response-validation",
    "session-management",
    "streaming",
    "sse",
    "server-sent-events",
    "chat",
    "websocket",
    "realtime"
  ],
  "packageManager": "npm@11.21.1",
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "esbuild@0.28.2": true
  },
  "homepage": "https://github.com/Heshammesalam/universal-api-layer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heshammesalam/universal-api-layer.git"
  },
  "bugs": {
    "url": "https://github.com/Heshammesalam/universal-api-layer/issues"
  }
}
